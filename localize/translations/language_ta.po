msgctxt "TC_OPT_ASXML"
msgid "convert HTML to well formed XHTML"
msgstr "உஉகுமொ ஐ நன்கு உருவாக்கிய XHTML ஆக மாற்றவும்"

msgctxt "TC_OPT_BARE"
msgid "strip out smart quotes and em dashes, etc."
msgstr "அறிவுள்ள மேற்கோள்கள் மற்றும் ஈ.எம் கோடுகள் போன்றவற்றை அகற்றவும்."

msgctxt "TC_OPT_BIG5"
msgid "use Big5 for both input and output"
msgstr "உள்ளீடு மற்றும் வெளியீடு இரண்டிற்கும் BIG5 ஐப் பயன்படுத்தவும்"

msgctxt "TC_OPT_CLEAN"
msgid "replace FONT, NOBR and CENTER tags with CSS"
msgstr "எழுத்துரு, NOBR மற்றும் மைய குறிச்சொற்களை சிஎச்எச் உடன் மாற்றவும்"

msgctxt "TC_OPT_CONFIG"
msgid "set configuration options from the specified <file>"
msgstr "குறிப்பிடப்பட்ட <file> இலிருந்து உள்ளமைவு விருப்பங்களை அமைக்கவும்"

msgctxt "TC_OPT_ERRORS"
msgid "show only errors and warnings"
msgstr "பிழைகள் மற்றும் எச்சரிக்கைகளை மட்டுமே காட்டுங்கள்"

msgctxt "TC_OPT_FILE"
msgid "write errors and warnings to the specified <file>"
msgstr "குறிப்பிட்ட <file> க்கு பிழைகள் மற்றும் எச்சரிக்கைகளை எழுதுங்கள்"

msgctxt "TC_OPT_GDOC"
msgid "produce clean version of html exported by Google Docs"
msgstr ""
"கூகிள் டாக்சால் ஏற்றுமதி செய்யப்பட்ட உஉகுமொ இன் தூய்மையான பதிப்பை "
"உருவாக்குங்கள்"

msgctxt "TC_OPT_HELP"
msgid "list the command line options"
msgstr "கட்டளை வரி விருப்பங்களை பட்டியலிடுங்கள்"

msgctxt "TC_OPT_HELPCFG"
msgid "list all configuration options"
msgstr "அனைத்து உள்ளமைவு விருப்பங்களையும் பட்டியலிடுங்கள்"

msgctxt "TC_OPT_HELPENV"
msgid "show information about the environment and runtime configuration"
msgstr "சுற்றுச்சூழல் மற்றும் இயக்க நேர உள்ளமைவு பற்றிய தகவல்களைக் காட்டு"

msgctxt "TC_OPT_HELPOPT"
msgid "show a description of the <option>"
msgstr "<விருப்பம்> இன் விளக்கத்தைக் காட்டு"

msgctxt "TC_OPT_IBM858"
msgid "use IBM-858 (CP850+Euro) for input, US-ASCII for output"
msgstr ""
"உள்ளீட்டிற்கு ஐபிஎம் -858 (சிபி 850+யூரோ) ஐப் பயன்படுத்தவும், வெளியீட்டிற்கு"
" யுஎச்-அசிஐஐ"

msgctxt "TC_OPT_INDENT"
msgid "indent element content"
msgstr "உறுப்பு உள்ளடக்கம்"

msgctxt "TC_OPT_ISO2022"
msgid "use ISO-2022 for both input and output"
msgstr "உள்ளீடு மற்றும் வெளியீடு இரண்டிற்கும் ஐஎச்ஓ -2022 ஐப் பயன்படுத்தவும்"

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_OPT_LANGUAGE"
msgid ""
"set Tidy's output language to <lang>. Specify '-language help' for more "
"help. Use before output-causing arguments to ensure the language takes "
"effect, e.g.,`tidy -lang es -lang help`."
msgstr ""
"டைடியின் வெளியீட்டு மொழியை <lang> ஆக அமைக்கவும். மேலும் உதவிக்கு '-மொழி "
"உதவி' குறிப்பிடவும். மொழி நடைமுறைக்கு வருவதை உறுதிசெய்ய வெளியீட்டை "
"உருவாக்கும் வாதங்களுக்கு முன் பயன்படுத்தவும், எ.கா., `நேர்த்தியான -லாங் எச் "
"-லாங் உதவி`."

msgctxt "TC_OPT_LATIN0"
msgid "use ISO-8859-15 for input, US-ASCII for output"
msgstr ""
"உள்ளீட்டிற்கு ஐஎச்ஓ -8859-15 ஐப் பயன்படுத்தவும், வெளியீட்டிற்கு யுஎச்-அசிஐஐ"

msgctxt "TC_OPT_LATIN1"
msgid "use ISO-8859-1 for both input and output"
msgstr "உள்ளீடு மற்றும் வெளியீடு இரண்டிற்கும் ISO-8859-1 ஐப் பயன்படுத்தவும்"

msgctxt "TC_OPT_MAC"
msgid "use MacRoman for input, US-ASCII for output"
msgstr "உள்ளீட்டிற்கு மேக்ரோமனை பயன்படுத்தவும், வெளியீட்டிற்கு யு.எச்-அசி"

msgctxt "TC_OPT_MODIFY"
msgid "modify the original input files"
msgstr "அசல் உள்ளீட்டு கோப்புகளை மாற்றவும்"

msgctxt "TC_OPT_NUMERIC"
msgid "output numeric rather than named entities"
msgstr "பெயரிடப்பட்ட நிறுவனங்களை விட வெளியீட்டு எண்"

msgctxt "TC_OPT_OMIT"
msgid "omit optional start tags and end tags"
msgstr ""
"விருப்ப தொடக்க குறிச்சொற்கள் மற்றும் இறுதி குறிச்சொற்களைத் தவிர்"

msgctxt "TC_OPT_OUTPUT"
msgid "write output to the specified <file>"
msgstr "குறிப்பிட்ட <file> க்கு வெளியீட்டை எழுதுங்கள்"

msgctxt "TC_OPT_QUIET"
msgid "suppress nonessential output"
msgstr "தேவையில்லாத வெளியீட்டை அடக்கவும்"

msgctxt "TC_OPT_RAW"
msgid "output values above 127 without conversion to entities"
msgstr "நிறுவனங்களாக மாற்றாமல் 127 க்கு மேல் வெளியீட்டு மதிப்புகள்"

msgctxt "TC_OPT_SHIFTJIS"
msgid "use Shift_JIS for both input and output"
msgstr "உள்ளீடு மற்றும் வெளியீடு இரண்டிற்கும் SHIFT_JIS ஐப் பயன்படுத்தவும்"

msgctxt "TC_OPT_SHOWCFG"
msgid "list the current configuration settings"
msgstr "தற்போதைய உள்ளமைவு அமைப்புகளை பட்டியலிடுங்கள்"

msgctxt "TC_OPT_EXP_CFG"
msgid "list the current configuration settings, suitable for a config file"
msgstr ""
"கட்டமைப்பு கோப்புக்கு ஏற்ற தற்போதைய உள்ளமைவு அமைப்புகளை பட்டியலிடுங்கள்"

msgctxt "TC_OPT_EXP_DEF"
msgid "list the default configuration settings, suitable for a config file"
msgstr ""
"இயல்புநிலை உள்ளமைவு அமைப்புகளை பட்டியலிடுங்கள், இது கட்டமைப்பு கோப்புக்கு "
"ஏற்றது"

msgctxt "TC_OPT_UPPER"
msgid "force tags to upper case"
msgstr "குறிச்சொற்களை மேல் வழக்குக்கு கட்டாயப்படுத்துங்கள்"

msgctxt "TC_OPT_UTF16"
msgid "use UTF-16 for both input and output"
msgstr "உள்ளீடு மற்றும் வெளியீடு இரண்டிற்கும் UTF-16 ஐப் பயன்படுத்தவும்"

msgctxt "TC_OPT_UTF16BE"
msgid "use UTF-16BE for both input and output"
msgstr "உள்ளீடு மற்றும் வெளியீடு இரண்டிற்கும் UTF-16BE ஐப் பயன்படுத்தவும்"

msgctxt "TC_OPT_UTF16LE"
msgid "use UTF-16LE for both input and output"
msgstr "உள்ளீடு மற்றும் வெளியீடு இரண்டிற்கும் UTF-16LE ஐப் பயன்படுத்தவும்"

msgctxt "TC_OPT_UTF8"
msgid "use UTF-8 for both input and output"
msgstr "உள்ளீடு மற்றும் வெளியீடு இரண்டிற்கும் UTF-8 ஐப் பயன்படுத்தவும்"

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_OPT_VERSION"
msgid "show the version of Tidy"
msgstr "நேர்த்தியின் பதிப்பைக் காட்டு"

msgctxt "TC_OPT_WIN1252"
msgid "use Windows-1252 for input, US-ASCII for output"
msgstr ""
"உள்ளீட்டிற்கு சாளரங்கள் -1252 ஐப் பயன்படுத்தவும், வெளியீட்டிற்கு யுஎச்-அசிஐஐ"
" பயன்படுத்தவும்"

msgctxt "TC_OPT_WRAP"
msgid ""
"wrap text at the specified <column>. 0 is assumed if <column> is missing. "
"When this option is omitted, the default of the configuration option 'wrap' "
"applies."
msgstr ""
"குறிப்பிட்ட <நெடுவரிசை> இல் உரையை மடிக்கவும். <நெடுவரிசை> காணவில்லை என்றால் "
"0 கருதப்படுகிறது. இந்த விருப்பம் தவிர்க்கப்படும்போது, ​​உள்ளமைவு "
"விருப்பத்தின் இயல்புநிலை 'மடக்கு' பொருந்தும்."

msgctxt "TC_OPT_XML"
msgid "specify the input is well formed XML"
msgstr "உள்ளீடு நன்கு உருவாக்கப்பட்ட எக்ச்எம்எல் என்பதைக் குறிப்பிடவும்"

msgctxt "TC_OPT_XMLCFG"
msgid "list all configuration options in XML format"
msgstr ""
"அனைத்து உள்ளமைவு விருப்பங்களையும் எக்ச்எம்எல் வடிவத்தில் பட்டியலிடுங்கள்"

msgctxt "TC_OPT_XMLHELP"
msgid "list the command line options in XML format"
msgstr "கட்டளை வரி விருப்பங்களை எக்ச்எம்எல் வடிவத்தில் பட்டியலிடுங்கள்"

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_OPT_XMLSTRG"
msgid "output all of Tidy's strings in XML format"
msgstr "எக்ச்எம்எல் வடிவத்தில் நேர்த்தியின் அனைத்து சரங்களையும் வெளியிடுங்கள்"

msgctxt "TC_OPT_XMLERRS"
msgid "output error constants and strings in XML format"
msgstr "எக்ச்எம்எல் வடிவத்தில் வெளியீட்டு பிழை மாறிலிகள் மற்றும் சரங்கள்"

msgctxt "TC_OPT_XMLOPTS"
msgid "output option descriptions in XML format"
msgstr "எக்ச்எம்எல் வடிவத்தில் வெளியீட்டு விருப்ப விளக்கங்கள்"

msgctxt "TC_STRING_CONF_HEADER"
msgid "Configuration File Settings:"
msgstr "உள்ளமைவு கோப்பு அமைப்புகள்:"

#. Must be 27 characters or fewer.
msgctxt "TC_STRING_CONF_NAME"
msgid "Name"
msgstr "பெயர்"

#. Must be 9 characters or fewer.
msgctxt "TC_STRING_CONF_TYPE"
msgid "Type"
msgstr "வகை"

#. Must be 40 characters or fewer.
msgctxt "TC_STRING_CONF_VALUE"
msgid "Current Value"
msgstr "தற்போதைய மதிப்பு"

#, c-format
msgctxt "TC_STRING_OPT_NOT_DOCUMENTED"
msgid "Warning: option `%s' is not documented."
msgstr "எச்சரிக்கை: விருப்பம் `%s 'ஆவணப்படுத்தப்படவில்லை."

msgctxt "TC_STRING_OUT_OF_MEMORY"
msgid "Out of memory. Bailing out."
msgstr "நினைவகத்திற்கு வெளியே. பிணை எடுப்பது."

#, c-format
msgctxt "TC_STRING_FATAL_ERROR"
msgid "Fatal error: impossible value for id='%d'."
msgstr "அபாயகரமான பிழை: அடையாளம் க்கு சாத்தியமற்ற மதிப்பு = '%d'."

msgctxt "TC_STRING_FILE_MANIP"
msgid "File manipulation"
msgstr "கோப்பு கையாளுதல்"

msgctxt "TC_STRING_PROCESS_DIRECTIVES"
msgid "Processing directives"
msgstr "செயலாக்க வழிமுறைகள்"

msgctxt "TC_STRING_CHAR_ENCODING"
msgid "Character encodings"
msgstr "எழுத்து குறியாக்கங்கள்"

msgctxt "TC_STRING_LANG_MUST_SPECIFY"
msgid "A POSIX or Windows locale must be specified."
msgstr "ஒரு போசிக்ச் அல்லது சாளரங்கள் லோகேல் குறிப்பிடப்பட வேண்டும்."

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#, c-format
msgctxt "TC_STRING_LANG_NOT_FOUND"
msgid "Tidy doesn't have language '%s,' will use '%s' instead."
msgstr "நேர்த்தியாக '%s மொழி இல்லை, அதற்கு பதிலாக'%s 'ஐப் பயன்படுத்தும்."

msgctxt "TC_STRING_MISC"
msgid "Miscellaneous"
msgstr "மற்றவை"

msgctxt "TC_STRING_XML"
msgid "XML"
msgstr "நீகுமொ"

msgctxt "TC_STRING_MUST_SPECIFY"
msgid "A Tidy option name must be specified."
msgstr "ஒரு நேர்த்தியான விருப்பத்தின் பெயர் குறிப்பிடப்பட வேண்டும்."

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_STRING_UNKNOWN_OPTION"
msgid "HTML Tidy: unknown option: %c"
msgstr "உஉகுமொ நேர்த்தியான: தெரியாத விருப்பம்: %c"

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_STRING_UNKNOWN_OPTION_B"
msgid "HTML Tidy: unknown option."
msgstr "உஉகுமொ நேர்த்தியான: தெரியாத விருப்பம்."

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#, c-format
msgctxt "TC_STRING_VERS_A"
msgid "HTML Tidy for %s version %s"
msgstr "%s பதிப்பு %s க்கான உஉகுமொ நேர்த்தியானது"

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#, c-format
msgctxt "TC_STRING_VERS_B"
msgid "HTML Tidy version %s"
msgstr "உஉகுமொ நேர்த்தியான பதிப்பு %s"

#. This console output should be limited to 78 characters per line.
#. - First %s represents the name of the executable from the file system, and
#. is mostly like going to be "tidy".
#. - Second %s represents a version number, typically x.x.xx.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#, c-format
msgctxt "TC_TXT_HELP_1"
msgid ""
"%s [options...] [file...] [options...] [file...]\n"
"Utility to clean up and pretty print HTML/XHTML/XML.\n"
"\n"
"This is modern HTML Tidy version %s.\n"
"\n"
msgstr ""
"%s [விருப்பங்கள்...] [கோப்பு...] [விருப்பங்கள்...] [கோப்பு...] \n"
"சுத்தம் செய்வதற்கான பயன்பாடு மற்றும் அழகாக அச்சிட HTML/XHTML/XML. \n"
"\n"
"இது நவீன உஉகுமொ நேர்த்தியான பதிப்பு %s.\n"

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#. - %s represents the platform, for example, "Mac OS X" or "Windows".
#, c-format
msgctxt "TC_TXT_HELP_2A"
msgid "Command Line Arguments for HTML Tidy for %s:"
msgstr "%s க்கு உஉகுமொ நேர்த்தியான கட்டளை வரி வாதங்கள்:"

#. The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_TXT_HELP_2B"
msgid "Command Line Arguments for HTML Tidy:"
msgstr "உஉகுமொ நேர்த்தியான கட்டளை வரி வாதங்கள்:"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#. - %s represents either a blank line, or TC_TXT_HELP_3A explaining
#. environment options.
#, c-format
msgctxt "TC_TXT_HELP_3"
msgid ""
"\n"
"Tidy Configuration Options\n"
"==========================\n"
" Use Tidy's configuration options as command line arguments in the form\n"
" of \"--some-option <value>\", for example, \"--indent-with-tabs yes\".\n"
"\n"
" You can also specify a file containing configuration options with the \n"
" -config <file> directive, or in one or more files specific to your \n"
" environment (see next section). \n"
"\n"
" For a list of all configuration options, use \"-help-config\" or refer\n"
" to the man page (if your OS has one).\n"
"\n"
"Configuration Files\n"
"===================\n"
" If your environment has an $HTML_TIDY variable set to point to a Tidy \n"
" configuration file, then Tidy will attempt to use it. \n"
"%s Use \"-help-env\" for more information about how you can use the environment. \n"
" to specify Tidy options. \n"
"\n"
"Other\n"
"=====\n"
" Input/Output default to stdin/stdout respectively.\n"
"\n"
" Single letter options apart from -f may be combined\n"
" as in:  tidy -f errs.txt -imu foo.html\n"
"\n"
"Information\n"
"===========\n"
" For more information about HTML Tidy, see\n"
"  https://www.html-tidy.org/\n"
"\n"
" For more information on HTML, see the following:\n"
"\n"
"   HTML Living Standard (the latest HTML specification)\n"
"   https://html.spec.whatwg.org/multipage/\n"
"\n"
" File bug reports at https://github.com/htacg/tidy-html5/issues/\n"
" or send questions and comments to public-htacg@w3.org.\n"
"\n"
" Validate your HTML documents using the W3C Nu Markup Validator:\n"
"   https://validator.w3.org/nu/\n"
"\n"
msgstr ""
"\n"
"நேர்த்தியான உள்ளமைவு விருப்பங்கள் \n"
"=========================== \n"
"படிவத்தில் கட்டளை வரி வாதங்களாக டைடியின் உள்ளமைவு விருப்பங்களைப் பயன்படுத்தவும் \n"
"\"--சில-விருப்ப <மதிப்பு>\", எடுத்துக்காட்டாக, \"--தாவல்களுடன் ஆம்\". \n"
"\n"
"உள்ளமைவு விருப்பங்களைக் கொண்ட ஒரு கோப்பையும் நீங்கள் குறிப்பிடலாம் \n"
"-கன்ஃபிக் <file> கட்டளை, அல்லது உங்களுக்கு குறிப்பிட்ட ஒன்று அல்லது அதற்கு மேற்பட்ட கோப்புகளில் \n"
"சூழல் (அடுத்த பகுதியைக் காண்க). \n"
"\n"
"அனைத்து உள்ளமைவு விருப்பங்களின் பட்டியலுக்கு, \"-help-config\" ஐப் பயன்படுத்தவும் அல்லது பார்க்கவும் \n"
"மேன் பக்கத்திற்கு (உங்கள் OS க்கு ஒன்று இருந்தால்). \n"
"\n"
"உள்ளமைவு கோப்புகள் \n"
"==================== \n"
"உங்கள் சூழலில் ஒரு நேர்த்தியை சுட்டிக்காட்ட $ HTML_TIDY மாறி அமைக்கப்பட்டிருந்தால் \n"
"உள்ளமைவு கோப்பு, பின்னர் நேர்த்தியாக அதைப் பயன்படுத்த முயற்சிக்கும். \n"
"நீங்கள் சூழலை எவ்வாறு பயன்படுத்தலாம் என்பது பற்றிய கூடுதல் தகவலுக்கு \"-help-env\" ஐப் பயன்படுத்துங்கள். \n"
"நேர்த்தியான விருப்பங்களைக் குறிப்பிட. \n"
"\n"
"மற்றொன்று \n"
"==== \n"
"உள்ளீடு/வெளியீட்டு இயல்புநிலை முறையே stdin/stdout க்கு. \n"
"\n"
"-F தவிர ஒற்றை கடிதம் விருப்பங்கள் இணைக்கப்படலாம் \n"
"உள்ளதைப் போல: tidy -f errs.txt -imu foo.html \n"
"\n"
"தகவல் \n"
"=========== \n"
"HTML நேர்த்தியைப் பற்றிய கூடுதல் தகவலுக்கு, பார்க்கவும் \n"
"https://www.html-tidy.org/ \n"
"\n"
"HTML பற்றிய கூடுதல் தகவலுக்கு, பின்வருவனவற்றைக் காண்க: \n"
"\n"
"HTML லிவிங் ச்டாண்டர்ட் (சமீபத்திய உஉகுமொ விவரக்குறிப்பு) \n"
"https://html.spec.whatwg.org/multipage/ \n"
"\n"
"கோப்பு பிழை அறிக்கைகள் https://github.com/htacg/tidy-html5/issues/ \n"
"அல்லது கேள்விகள் மற்றும் கருத்துகளை பொது-htacg@w3.org க்கு அனுப்பவும். \n"
"\n"
"W3C Nu Markup Validator ஐப் பயன்படுத்தி உங்கள் உஉகுமொ ஆவணங்களை சரிபார்க்கவும்: \n"
"https://validator.w3.org/nu/\n"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#. - Both parameters %s reflect file paths and names.
#, c-format
msgctxt "TC_TXT_HELP_3A"
msgid ""
"\n"
" Additionally, Tidy will automatically attempt to use configuration specified \n"
" in these files, if present: \n"
"\n"
"  %s \n"
"  %s \n"
"\n"
msgstr ""
"\n"
"கூடுதலாக, நேர்த்தியாக தானாகவே குறிப்பிடப்பட்ட உள்ளமைவைப் பயன்படுத்த முயற்சிக்கும் \n"
"இந்த கோப்புகளில், இருந்தால்: \n"
"\n"
"%s \n"
"%s \n"
"\n"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_TXT_HELP_CONFIG"
msgid ""
"\n"
"HTML Tidy Configuration Settings\n"
"\n"
"Within a file, use the form:\n"
"\n"
"wrap: 72\n"
"indent: no\n"
"\n"
"When specified on the command line, use the form:\n"
"\n"
"--wrap 72 --indent no\n"
"\n"
msgstr ""
"\n"
"உஉகுமொ நேர்த்தியான உள்ளமைவு அமைப்புகள் \n"
"\n"
"ஒரு கோப்பிற்குள், படிவத்தைப் பயன்படுத்தவும்: \n"
"\n"
"மடக்கு: 72 \n"
"உள்தள்ளல்: இல்லை \n"
"\n"
"கட்டளை வரியில் குறிப்பிடப்படும்போது, ​​படிவத்தைப் பயன்படுத்தவும்: \n"
"\n"
"-மடக்கு 72 --உள்தள்ளல் இல்லை\n"

msgctxt "TC_TXT_HELP_CONFIG_NAME"
msgid "Name"
msgstr "பெயர்"

msgctxt "TC_TXT_HELP_CONFIG_TYPE"
msgid "Type"
msgstr "வகை"

msgctxt "TC_TXT_HELP_CONFIG_ALLW"
msgid "Allowable values"
msgstr "அனுமதிக்கக்கூடிய மதிப்புகள்"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#. - The first %s indicates two more list items, or an empty string.
#. - The second %s indicates a file name, or a message indicating no file
#. name.
#, c-format
msgctxt "TC_TXT_HELP_ENV_1"
msgid ""
"\n"
"Tidy can configure its option values from multiple sources, in the \n"
"order below. Subsequent use of the same option overrides previous \n"
"option settings. \n"
"\n"
" - Tidy's built-in default values. \n"
"%s\" /* rc files */ - The file specified in the $HTML_TIDY environment variable: \n"
"     %s \n"
" - Options in a file specified on the command line. \n"
" - Options set directly on the command line. \n"
msgstr ""
"\n"
"நேர்த்தியாக அதன் விருப்ப மதிப்புகளை பல மூலங்களிலிருந்து கட்டமைக்க முடியும் \n"
"கீழே ஆர்டர். அதே விருப்பத்தின் அடுத்தடுத்த பயன்பாடு முந்தையதை மீறுகிறது \n"
"விருப்ப அமைப்புகள். \n"
"\n"
"- நேர்த்தியின் உள்ளமைக்கப்பட்ட இயல்புநிலை மதிப்புகள். \n"
"%s \" / * rc கோப்புகள் * / - $ HTML_TIDY சூழல் மாறியில் குறிப்பிடப்பட்டுள்ள கோப்பு: \n"
"%s \n"
"- கட்டளை வரியில் குறிப்பிடப்பட்டுள்ள கோப்பில் விருப்பங்கள். \n"
"- கட்டளை வரியில் நேரடியாக அமைக்கப்பட்ட விருப்பங்கள்.\n"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#, c-format
msgctxt "TC_TXT_HELP_ENV_1A"
msgid ""
" - The system runtime configuration file: \n"
"     %s \n"
" - The user runtime configuration file: \n"
"     %s \n"
msgstr ""
"- கணினி இயக்க நேர உள்ளமைவு கோப்பு: \n"
"%s \n"
"- பயனர் இயக்க நேர உள்ளமைவு கோப்பு: \n"
"%s\n"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#. - This message indicates that a file name is not currently set.
msgctxt "TC_TXT_HELP_ENV_1B"
msgid "(not currently set)"
msgstr "(தற்போது அமைக்கப்படவில்லை)"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#, c-format
msgctxt "TC_TXT_HELP_ENV_1C"
msgid ""
"\n"
"Note that because $HTML_TIDY is set, the user runtime configuration file \n"
"%s will not be used. \n"
msgstr ""
"\n"
"$ HTML_TIDY அமைக்கப்பட்டிருப்பதால், பயனர் இயக்க நேர உள்ளமைவு கோப்பு \n"
"%s பயன்படுத்தப்படாது.\n"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_TXT_HELP_LANG_1"
msgid ""
"\n"
"The -language (or -lang) option indicates which language Tidy \n"
"should use to communicate its output. Please note that this is not \n"
"a document translation service, and only affects the messages that \n"
"Tidy communicates to you. \n"
"\n"
"When used from the command line the -language argument must \n"
"be used before any arguments that result in output, otherwise Tidy \n"
"will produce output before it knows which language to use. \n"
"\n"
"In addition to standard POSIX language codes, Tidy is capable of \n"
"understanding legacy Windows language codes. Please note that this \n"
"list indicates codes Tidy understands, and does not indicate that \n"
"the language is currently installed. \n"
"\n"
"The rightmost column indicates how Tidy will understand the \n"
"legacy Windows name.\n"
"\n"
msgstr ""
"\n"
"-நாள் (அல்லது -லாங்) விருப்பம் எந்த மொழி நேர்த்தியாக குறிக்கிறது என்பதைக் குறிக்கிறது \n"
"அதன் வெளியீட்டைத் தொடர்பு கொள்ள பயன்படுத்த வேண்டும். இது இல்லை என்பதை நினைவில் கொள்க \n"
"ஒரு ஆவண மொழிபெயர்ப்பு பணி, மற்றும் செய்திகளை மட்டுமே பாதிக்கிறது \n"
"நேர்த்தியானது உங்களுக்கு தொடர்பு கொள்கிறது. \n"
"\n"
"கட்டளை வரியிலிருந்து பயன்படுத்தும்போது -மொழி உரையாடல் வேண்டும் \n"
"வெளியீட்டை விளைவிக்கும் எந்தவொரு வாதத்திற்கும் முன் பயன்படுத்தப்பட வேண்டும், இல்லையெனில் நேர்த்தியாக \n"
"எந்த மொழியைப் பயன்படுத்த வேண்டும் என்பதை அறிவதற்கு முன்பு வெளியீட்டை உருவாக்கும். \n"
"\n"
"நிலையான POSIX மொழி குறியீடுகளுக்கு கூடுதலாக, நேர்த்தியான திறன் கொண்டது \n"
"மரபு சாளரங்கள் மொழி குறியீடுகளைப் புரிந்துகொள்வது. இதை நினைவில் கொள்க \n"
"பட்டியல் குறியீடுகளை நேர்த்தியாக புரிந்துகொள்வதைக் குறிக்கிறது, அதைக் குறிக்கவில்லை \n"
"மொழி தற்போது நிறுவப்பட்டுள்ளது. \n"
"\n"
"வலதுபுற நெடுவரிசை எவ்வாறு நேர்த்தியாக புரிந்துகொள்ளும் என்பதைக் குறிக்கிறது \n"
"மரபு சாளரங்கள் பெயர்.\n"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
msgctxt "TC_TXT_HELP_LANG_2"
msgid ""
"\n"
"The following languages are currently installed in Tidy. Please \n"
"note that there's no guarantee that they are complete; only that \n"
"one developer or another started to add the language indicated. \n"
"\n"
"Incomplete localizations will default to \"en\" when necessary. \n"
"Please report instances of incorrect strings to the Tidy team. \n"
"\n"
msgstr ""
"\n"
"பின்வரும் மொழிகள் தற்போது நேர்த்தியாக நிறுவப்பட்டுள்ளன. தயவுசெய்து \n"
"அவை முழுமையானவை என்பதற்கு எந்த உத்தரவாதமும் இல்லை என்பதை நினைவில் கொள்க; அது மட்டுமே \n"
"ஒரு உருவாக்குபவர் அல்லது இன்னொருவர் சுட்டிக்காட்டப்பட்ட மொழியைச் சேர்க்கத் தொடங்கினார். \n"
"\n"
"முழுமையற்ற உள்ளூர்மயமாக்கல்கள் தேவைப்படும்போது \"en\" க்கு இயல்புநிலையாக இருக்கும். \n"
"தவறான சரங்களின் நிகழ்வுகளை நேர்த்தியான குழுவுக்கு தெரிவிக்கவும்.\n"

#. This console output should be limited to 78 characters per line.
#. - The strings "Tidy" and "HTML Tidy" are the program name and must not be
#. translated.
#. - The parameter %s is likely to be two to five characters, e.g., en or
#. en_US.
#, c-format
msgctxt "TC_TXT_HELP_LANG_3"
msgid ""
"\n"
"If Tidy is able to determine your locale then Tidy will use the \n"
"locale's language automatically. For example Unix-like systems use a \n"
"$LANG and/or $LC_ALL environment variable. Consult your operating \n"
"system documentation for more information. \n"
"\n"
"Tidy is currently using locale %s. \n"
"\n"
msgstr ""
"\n"
"நேர்த்தியாக உங்கள் இருப்பிடத்தை தீர்மானிக்க முடிந்தால், நேர்த்தியாகப் பயன்படுத்தும் \n"
"லோகேலின் மொழி தானாகவே. எடுத்துக்காட்டாக யூனிக்ச் போன்ற அமைப்புகள் ஒரு \n"
"$LANG மற்றும்/அல்லது $LC_ALL சுற்றுச்சூழல் மாறி. உங்கள் இயக்கத்தை அணுகவும் \n"
"மேலும் தகவலுக்கு கணினி ஆவணங்கள். \n"
"\n"
"டைடி தற்போது %s லோகேல் பயன்படுத்துகிறது.\n"
